{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints/**/*",
    "components/**/*",
    "lib/**/*",
    "styles/**/*"
  ],
  "exclude": [
    "node_modules",
    ".output"
  ]
}
