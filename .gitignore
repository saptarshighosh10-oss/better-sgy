# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local user data (real grades, emails, preferences — never commit)
/data/*.json
/data/_debug/

# persistent browser profile (school Google session cookies — never commit)
/.school-browser-profile/

# claude/agent tooling — local only
/.claude/
/.agents/
/.impeccable/
/.playwright-mcp/

# debug artifacts
/data/activity-debug.html
/data/gmail-debug.html
/data/schoology-debug.html
/data/gmail-debug.png
/data/schoology-debug.png
/verify-overview.png

# extension build artifacts + debug dumps (real student data — never commit)
extension/node_modules/
extension/.output/
extension/.wxt/
extension/.debug/
